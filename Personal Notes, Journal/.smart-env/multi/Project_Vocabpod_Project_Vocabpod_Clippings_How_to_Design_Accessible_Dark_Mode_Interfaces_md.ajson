te#{1}":[126,131],"##Icons":[132,141],"##Icons#{1}":[134,141],"##Images":[142,171],"##Images#{1}":[144,149],"##Images#{2}":[150,150],"##Images#{3}":[151,154],"##Images#{4}":[155,155],"##Images#{5}":[156,161],"##Images#Summary":[162,169],"##Images#Summary#{1}":[164,164],"##Images#Summary#{2}":[165,165],"##Images#Summary#{3}":[166,166],"##Images#Summary#{4}":[167,167],"##Images#Summary#{5}":[168,169],"##Images#Resources":[170,171],"##[Material Design](https://m2.material.io/design/color/dark-theme.html?source=post_page-----17f38ecea2e9---------------------------------------)":[172,180],"##[Material Design](https://m2.material.io/design/color/dark-theme.html?source=post_page-----17f38ecea2e9---------------------------------------)#Build beautiful, usable products faster. Material Design is an adaptable system-backed by open-source code-that helps…":[174,180],"##[Material Design](https://m2.material.io/design/color/dark-theme.html?source=post_page-----17f38ecea2e9---------------------------------------)#Build beautiful, usable products faster. Material Design is an adaptable system-backed by open-source code-that helps…#{1}":[176,180]},"outlinks":[{"title":"Joseph Odeyemi","target":"Joseph Odeyemi","line":5},{"title":"A screenshot of components for a darkmode UI kit","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*SDF5ryM6GChP4Oww-UpMnA.png","line":14,"embedded":true},{"title":"HSB/HSL colour system","target":"https://www.learnui.design/blog/the-hsb-colour-system-practicioners-primer.html","line":30},{"title":"Colour Accessibility","target":"https://uxplanet.org/heres-what-you-need-to-know-about-colour-accessibility-in-product-design-aecbd0c30628","line":32},{"title":"A shot showing the tonal palette for a ui design and the application of the primary base across light and dark themes","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*ahtpt6QPe2Qar3b2Al8o3w.png","line":46,"embedded":true},{"title":"A shot showing the correct application of desatuarted color as accent on darkmode along with WCAG contrast value showing sufficient contrast against the dark background.","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*Cl_i5DJKYfCsupk4ElaKWA.png","line":52,"embedded":true},{"title":"A shot discouraging of saturated colors due to visual vibrations","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*AuCBAljZKojIm3I2VrdyoA.png","line":58,"embedded":true},{"title":"A shot showing couple of pure and tinted geys filled rectangular blocks along with their HSL color values","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*aK6L8jGDsuB1TobRDu_sng.png","line":72,"embedded":true},{"title":"refactoring UI","target":"https://www.refactoringui.com/","line":78},{"title":"Shows four shot of four cards ,one in light theme and three in dark theme depicting how to express elevation","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*_gOf6-ZGlDs71b_dDtp6HA.png","line":84,"embedded":true},{"title":"four rectangular blocks of tinted gray with decreasing lightness from top to bottom ,depicting concept of elevation with flat surfaces in darkmode","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*74qJOPsNfuoqtx_hXfxjjg.png","line":98,"embedded":true},{"title":"a shot of ui elements tab bar, input field showing how to use light and dark shade of grey to depict depth","target":"https://miro.medium.com/v2/resize:fit:1374/format:webp/1*nmL7PxAz0dYOyq-GiwfcZQ.png","line":106,"embedded":true},{"title":"A shot of three cards on a dark background with text colored pure white ,semi transparent white and light gray respectively.","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*wlWWyHgMdHDVI0OeTzDwqA.png","line":120,"embedded":true},{"title":"A shot showing semi transparent white and light grey with the former recommended as it blends with the colored backgroud .","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*KHrojFBVrKo0m2cVWKjwxQ.png","line":128,"embedded":true},{"title":"A shot of outlined icons with varying stroke weight","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*SUY6wEBfj8ifQRKKsict2A.png","line":138,"embedded":true},{"title":"A shot of two card with images in both light and dark themes","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*FZFrX0MAe1kx54t-4fbO9w.png","line":144,"embedded":true},{"title":"A shot of reduced contrast image on a darkmode card","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*UXz60G85TV-lve66NXzCFA.png","line":151,"embedded":true},{"title":"dark mode card with an image using a dark overlay to reduce image brightness","target":"https://miro.medium.com/v2/resize:fit:1400/format:webp/1*9T3RiKdNKg2GhPWsglqMuw.png","line":156,"embedded":true},{"title":"Material Design","target":"https://m2.material.io/design/color/dark-theme.html?source=post_page-----17f38ecea2e9---------------------------------------","line":172},{"title":"follow","target":"https://medium.com/@tundehercules","line":180},{"title":"subscrib","target":"https://medium.com/subscribe/@tundehercules","line":180}],"metadata":{"title":"How to Design Accessible Dark Mode Interfaces","source":"https://medium.com/@tundehercules/designing-effective-dark-mode-interfaces-17f38ecea2e9","author":["[[Joseph Odeyemi]]"],"published":"2023-03-06","created":"2026-05-25","description":"Key Design Elements and Best Practices","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"Project Vocabpod/Project Vocabpod/Clippings/How to Design Accessible Dark Mode Interfaces.md"},
